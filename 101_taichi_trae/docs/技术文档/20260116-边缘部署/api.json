{
  "name": "edge-deploy",
  "basePath": "/edge_deploy/api",
  "responseEnvelope": { "status": 0, "message": "success", "result": {} },
  "auth": {
    "user": "existing session-based auth (g.user)",
    "agent": "Authorization: Bearer <device_token or enrollment_token>"
  },
  "conventions": {
    "tenantIsolation": "all user APIs filter by g.user.tenant_id; all agent APIs bind token -> (tenant_id, device_id)",
    "idempotency": {
      "agentAck": "Ack/Report endpoints must be idempotent; repeated requests should not create side effects",
      "userCreate": "user-side create endpoints can optionally accept Idempotency-Key header later"
    },
    "commandDelivery": {
      "cursor": "agent maintains last_seen_command_id (cursor) and sends it in pull",
      "lease": "server leases commands to a device for lease_seconds; expired leases are re-queued for retry",
      "longPoll": "pull can long-poll for long_poll_seconds to reduce empty polling"
    }
  },
  "endpoints": [
    {
      "method": "GET",
      "path": "/devices",
      "audience": "user",
      "description": "List edge devices (paged/filtered)",
      "auth": "user",
      "query": {
        "page": 0,
        "page_size": 10,
        "status": "online|offline|unknown",
        "keyword": "optional",
        "project_id": "optional"
      },
      "response": {
        "items": [
          {
            "id": 1,
            "tenant_id": "t-xxx",
            "project_id": 1,
            "name": "robot-01",
            "device_uid": "sn-xxx",
            "status": "online",
            "last_seen_at": "2026-01-16T12:00:00Z",
            "ip": "10.0.0.2",
            "agent_version": "0.1.0",
            "capabilities": {}
          }
        ],
        "page": 0,
        "page_size": 10,
        "total": 123
      }
    },
    {
      "method": "GET",
      "path": "/devices/{device_id}",
      "audience": "user",
      "description": "Get device detail",
      "auth": "user",
      "response": {
        "device": {
          "id": 1,
          "name": "robot-01",
          "device_uid": "sn-xxx",
          "status": "online",
          "last_seen_at": "2026-01-16T12:00:00Z",
          "agent_version": "0.1.0",
          "capabilities": {}
        },
        "recent_instances": [
          {
            "instance_id": 1001,
            "deployment_id": 101,
            "service_id": 10,
            "status": "running",
            "last_reported_at": "2026-01-16T12:00:00Z",
            "last_error": ""
          }
        ]
      }
    },
    {
      "method": "POST",
      "path": "/devices/enrollment_tokens",
      "audience": "user",
      "description": "Create one-time enrollment token for device registration",
      "auth": "user",
      "request": { "project_id": 1, "expires_in_seconds": 3600, "note": "lab-robot" },
      "response": { "token": "***", "expires_at": "2026-01-16T12:00:00Z" }
    },
    {
      "method": "POST",
      "path": "/services",
      "audience": "user",
      "description": "Create an edge service template",
      "auth": "user",
      "request": {
        "project_id": 1,
        "name": "svc-a",
        "describe": "",
        "runtime_type": "docker|process",
        "image": "repo/img:tag",
        "working_dir": "/app",
        "command": "python app.py",
        "envs": { "KEY": "VALUE" },
        "ports": [{ "name": "http", "container_port": 8080, "host_port": 0, "protocol": "tcp" }],
        "resources": { "cpu_cores": 2, "memory_mb": 4096, "gpu_count": 0 },
        "artifact_id": 123,
        "model_id": "optional",
        "model_version_id": "optional"
      },
      "response": { "id": 10 }
    },
    {
      "method": "POST",
      "path": "/services/list",
      "audience": "user",
      "description": "List edge service templates",
      "auth": "user",
      "request": { "page": 0, "page_size": 10, "keyword": "optional", "project_id": "optional" },
      "response": {
        "items": [{ "id": 10, "name": "svc-a", "runtime_type": "docker", "image": "repo/img:tag" }],
        "page": 0,
        "page_size": 10,
        "total": 1
      }
    },
    {
      "method": "GET",
      "path": "/services/{service_id}",
      "audience": "user",
      "description": "Get service template detail",
      "auth": "user"
    },
    {
      "method": "POST",
      "path": "/services/{service_id}/update",
      "audience": "user",
      "description": "Update service template",
      "auth": "user"
    },
    {
      "method": "POST",
      "path": "/deployments",
      "audience": "user",
      "description": "Create a deployment and enqueue commands to target devices",
      "auth": "user",
      "request": { "service_id": 10, "device_ids": [1, 2, 3], "strategy": "all_at_once" },
      "response": { "id": 101 }
    },
    {
      "method": "POST",
      "path": "/deployments/list",
      "audience": "user",
      "description": "List deployments",
      "auth": "user",
      "request": { "page": 0, "page_size": 10, "status": "optional", "service_id": "optional" },
      "response": {
        "items": [{ "id": 101, "service_id": 10, "status": "pending", "created_on": "2026-01-16T12:00:00Z" }],
        "page": 0,
        "page_size": 10,
        "total": 1
      }
    },
    {
      "method": "GET",
      "path": "/deployments/{deployment_id}",
      "audience": "user",
      "description": "Get deployment detail with per-device instances",
      "auth": "user",
      "response": {
        "deployment": { "id": 101, "service_id": 10, "status": "running", "strategy": "all_at_once", "desired_version": "repo/img:tag" },
        "instances": [
          { "id": 1001, "device_id": 1, "status": "running", "current_version": "repo/img:tag", "last_error": "" }
        ],
        "summary": { "total": 3, "running": 2, "failed": 1 }
      }
    },
    {
      "method": "POST",
      "path": "/deployments/{deployment_id}/actions",
      "audience": "user",
      "description": "Start/stop/restart/redeploy deployments (optionally per device subset)",
      "auth": "user",
      "request": { "action": "start|stop|restart|redeploy", "device_ids": [1, 2] },
      "response": { "enqueued": 2 }
    },
    {
      "method": "POST",
      "path": "/agent/register",
      "audience": "agent",
      "description": "Register device using enrollment token and mint device_token",
      "auth": "agent(enrollment_token)",
      "request": {
        "device_uid": "sn-xxx",
        "name": "robot-01",
        "agent_version": "0.1.0",
        "runtime_type": "docker",
        "os": "linux",
        "arch": "arm64",
        "capabilities": { "cpu_arch": "arm64", "has_gpu": false }
      },
      "response": {
        "device_id": 1,
        "device_token": "***",
        "poll_interval_seconds": 5,
        "long_poll_seconds": 25,
        "lease_seconds": 30
      }
    },
    {
      "method": "POST",
      "path": "/agent/heartbeat",
      "audience": "agent",
      "description": "Device heartbeat and status/metrics reporting",
      "auth": "agent(device_token)",
      "request": {
        "device_id": 1,
        "status": "online",
        "ip": "10.0.0.2",
        "metrics": { "cpu_pct": 10.5, "mem_pct": 52.1, "disk_pct": 40.2 },
        "tags": { "site": "lab", "rack": "r1" }
      },
      "response": { "ok": true }
    },
    {
      "method": "POST",
      "path": "/agent/commands/pull",
      "audience": "agent",
      "description": "Pull queued commands for the device (cursor + lease + long-poll)",
      "auth": "agent(device_token)",
      "request": { "device_id": 1, "cursor": 123, "limit": 10, "long_poll_seconds": 25, "lease_seconds": 30 },
      "response": {
        "cursor": 456,
        "server_time": "2026-01-16T12:00:00Z",
        "commands": [{ "id": 124, "instance_id": 1001, "type": "download_artifact", "payload": { "artifact_id": 123 } }]
      },
      "notes": [
        "server may return empty commands with the same cursor",
        "commands returned are leased and should be acked before lease expires"
      ]
    },
    {
      "method": "POST",
      "path": "/agent/commands/ack",
      "audience": "agent",
      "description": "Acknowledge command execution result (idempotent)",
      "auth": "agent(device_token)",
      "request": { "command_id": 124, "success": true, "detail": { "duration_ms": 1200 } },
      "response": { "ok": true },
      "notes": ["repeated ack for the same command_id should be accepted (idempotent)"]
    },
    {
      "method": "POST",
      "path": "/agent/report_instance_status",
      "audience": "agent",
      "description": "Report runtime status of a deployment instance (idempotent update)",
      "auth": "agent(device_token)",
      "request": {
        "instance_id": 1001,
        "status": "pending|downloading|starting|running|stopped|failed|unknown",
        "endpoint": { "host": "10.0.0.2", "port": 30000 },
        "detail": { "container_id": "abc", "image": "repo/img:tag" },
        "error_msg": ""
      },
      "response": { "ok": true }
    },
    {
      "method": "GET",
      "path": "/agent/artifacts/{artifact_id}/download_url",
      "audience": "agent",
      "description": "Get signed download URL for an artifact (optional)",
      "auth": "agent(device_token)",
      "response": { "url": "https://...signed...", "expires_at": "2026-01-16T12:10:00Z" }
    }
  ]
}
